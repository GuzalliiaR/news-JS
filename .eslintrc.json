{
    "parser": "@typescript-eslint/parser",
    "plugins": ["prettier", "import", "@typescript-eslint"],
    "extends": [
        "eslint:recommended",
        "plugin:@typescript-eslint/recommended",
        "plugin:prettier/recommended",
        "prettier"
    ],
    "parserOptions": {
        "ecmaVersion": 2020,
        "sourceType": "module"
    },
    "env": {
        "es6": true,
        "browser": true,
        "node": true
    },
    "rules": {
        "no-debugger": "off",
        "no-console": 0,
        "class-methods-use-this": "off"
    },

    // Не применять правила для TS к конфигурационным файлам Webpack, это файлы для Node.js
    "overrides": [
        {
            "files": ["webpack.config.js", "webpack.*.config.js"],
            "env": {
                "node": true
            },
            "rules": {
                "@typescript-eslint/no-require-imports": "off"
            }
        }
    ]
}
