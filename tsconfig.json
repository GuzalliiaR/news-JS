{
  // "allowJs", "checkJs" - удалить, когда все js файлы будут переименованы на ts

  "compilerOptions": {
    "target": "ES6",
    "lib": ["ES6", "dom"],                         // Типы встроенных API, о которых знает проверка (это target + DOM)
    "types": ["node"],                             // Объясняет компилятору все глобальные типы переменных Node.js (работает после установки пакета: npm i --save-dev @types/node)
    "module": "ESNext",                            // Использовать современные модули (import/export)
    "moduleResolution": "bundler",                 // Как пути импорта ищутся на диске - позволяет импортировать модули без указаний расширений файлов

    "strict": true,                                // Включает всё семейство строгих проверок
    "noImplicitAny": true,                         // Запрет на использование any

    "esModuleInterop": true,                       // Позволяет импортировать пакеты CommonJS-модулей по умолчанию
    "skipLibCheck": true,                          // Пропускает проверку типов внутри node_modules (ускоряет сборку)

    "forceConsistentCasingInFileNames": true,      // Заставляет TypeScript строго следить за регистром букв (большие/маленькие) в путях к файлам при их импорте
    "rootDir": "./src",                            // Папка, структура которой повторяется в outDir
    "outDir": "./dist",                            // Куда попадают файлы .js
    // с "rootDir": "./src" файл src/api/users.ts становится dist/api/users.js

    "allowJs": true,                              // Разрешает TypeScript включать .js файлы в проект
    "checkJs": false,                             // пока не проверять типы в .js файлах

    "isolatedModules": true,                      // Защищает от ошибок при использовании быстрых сборщиков, которые не умеют читать весь проект целиком
  },

  "include": ["src"],                            // Указывает в каких папках проекта искать файлы для компиляции
  
  "exclude": ["node_modules", "dist"]            // Указывает какие папки нужно полностью игнорировать при автоматическом поиске файлов
}
